{
  "name": "context-grapple-gun",
  "version": "5.0.0",
  "description": "Portable, harness-agnostic governance lifecycle for the Ubiquity substrate: cognitive PRs, scoped promotion, and cross-session lesson compounding. cgg-runtime is the Claude Code adapter today; cogpr carries the conventions for any platform.",
  "type": "module",
  "bin": {
    "cgg": "bin/cgg.mjs"
  },
  "files": [
    ".claude-plugin/",
    "assets/",
    "bin/",
    "cgg-runtime/",
    "docs/",
    "hooks/",
    "lib/",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "CGG_RUNTIME_TOPOLOGY_AND_LIFECYCLE.md",
    "DEV-README.md",
    "INSTALL.md",
    "LICENSE",
    "README.md",
    "release-status.json",
    "release-manifest.json",
    "START-HERE.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && python3 -m unittest cgg-runtime/scripts/test_effective_record.py",
    "test:distribution": "node --test test/distribution-contract.test.mjs",
    "test:effective-record": "python3 -m unittest cgg-runtime/scripts/test_effective_record.py",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "claude-code",
    "governance",
    "autonomy",
    "agents",
    "cogpr",
    "plugin"
  ],
  "author": "Prompted LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prompted365/context-grapple-gun.git"
  },
  "homepage": "https://github.com/prompted365/context-grapple-gun#readme",
  "bugs": {
    "url": "https://github.com/prompted365/context-grapple-gun/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
